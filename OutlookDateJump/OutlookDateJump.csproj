    <SignManifests>false</SignManifests>
    <!-- ===================================================================
         语义化版本（semver.org）：仓库根的 VERSION 文件是唯一事实来源。
         格式：MAJOR.MINOR.PATCH[-预发布标识]，例如 1.4.0 / 1.4.0-rc.1。
         这里在「求值期」直接读文件并拆解，避免 csproj / AssemblyInfo / 打包脚本
         三处各写一份版本号而互相漂移。
         - SemVerFull  : 完整字符串（1.4.0 或 1.4.0-rc.1），用于展示与 InformationalVersion
         - SemVerMajor/Minor/Patch : 三个数字段
         - ApplicationVersion : ClickOnce 要求 4 段数字，故用 MAJOR.MINOR.PATCH.0
         - ApplicationRevision：ClickOnce 的“修订号”，必须单调递增才能触发重新部署，
                                由 build_publish.cmd 从 tools\revision.txt 递增后经命令行传入。
         =================================================================== -->
    <VersionFile>$(MSBuildThisFileDirectory)..\VERSION</VersionFile>
    <SemVerFull Condition="Exists('$(VersionFile)')">$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</SemVerFull>
    <SemVerFull Condition="'$(SemVerFull)' == ''">0.0.0</SemVerFull>
    <SemVerCore>$([System.String]::Copy('$(SemVerFull)').Split('-')[0])</SemVerCore>
    <SemVerMajor>$([System.String]::Copy('$(SemVerCore)').Split('.')[0])</SemVerMajor>
    <SemVerMinor>$([System.String]::Copy('$(SemVerCore)').Split('.')[1])</SemVerMinor>
    <SemVerPatch>$([System.String]::Copy('$(SemVerCore)').Split('.')[2])</SemVerPatch>
    <SemVerPrerelease Condition="$(SemVerFull.Contains('-'))">$([System.String]::Copy('$(SemVerFull)').Split('-')[1])</SemVerPrerelease>
    <AssemblyVersion>$(SemVerMajor).$(SemVerMinor).$(SemVerPatch).0</AssemblyVersion>
    <FileVersion>$(SemVerMajor).$(SemVerMinor).$(SemVerPatch).0</FileVersion>
    <InformationalVersion>$(SemVerFull)</InformationalVersion>
    <ApplicationRevision>1</ApplicationRevision>
    <ApplicationVersion>$(SemVerMajor).$(SemVerMinor).$(SemVerPatch).0</ApplicationVersion>
    <PublishUrl>publish\</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <MapFileExtensions>true</MapFileExtensions>
