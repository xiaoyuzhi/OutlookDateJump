  <!-- ===================================================================
       生成版本属性文件：把 VERSION（语义化版本）解析结果写进程序集元数据。
       放在 obj\ 下（可再生、不进版本库），并在编译前生成。
       用 WriteCodeFragment 任务（专为程序集属性设计），避免字符串转义踩坑。
       =================================================================== -->
  <PropertyGroup>
    <!-- 用绝对路径，避免 compile_check.cmd 覆盖 OutputPath 时 IntermediateOutputPath
         变成相对路径而导致编译找不到生成文件。 -->
    <GeneratedVersionAssemblyInfoDir>$(MSBuildProjectDirectory)\obj\Generated\</GeneratedVersionAssemblyInfoDir>
    <GeneratedVersionAssemblyInfoFile>$(GeneratedVersionAssemblyInfoDir)VersionAssemblyInfo.g.cs</GeneratedVersionAssemblyInfoFile>
  </PropertyGroup>
  <Target Name="GenerateVersionAssemblyInfo" BeforeTargets="BeforeCompile;CoreCompile">
    <MakeDir Directories="$(GeneratedVersionAssemblyInfoDir)" />
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyVersionAttribute">
        <_Parameter1>$(AssemblyVersion)</_Parameter1>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyFileVersionAttribute">
        <_Parameter1>$(FileVersion)</_Parameter1>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute">
        <_Parameter1>$(InformationalVersion)</_Parameter1>
      </AssemblyAttribute>
    </ItemGroup>
    <WriteCodeFragment AssemblyAttributes="@(AssemblyAttribute)"
                      Language="C#"
                      OutputFile="$(GeneratedVersionAssemblyInfoFile)" />
    <ItemGroup>
      <Compile Include="$(GeneratedVersionAssemblyInfoFile)" />
      <FileWrites Include="$(GeneratedVersionAssemblyInfoFile)" />
    </ItemGroup>
  </Target>
