  "cards": [
    {
      "dot": "cyan",
      "title": "主链路",
      "items": [
        "用户点击按钮 → Ribbon1 回调 → 弹出 WPF 选择窗口 → COM 调用 GoToDate",
        "按钮在日历「开始」选项卡的「跳转」组（UIA 实测落在「排列」与「管理日历」之间）",
        "年/月/日三下拉为滑动窗口 ±5：只显示选中值前后各 5 项，选中恒居中，点到边界项即重锚",
        "窗口关闭后以 SelectedDate 返回；首拍 GoToDate（带 Apply）成功即结束，失败才由 120ms Timer 兜底"
      ]
    },
    {
      "dot": "emerald",
      "title": "宿主与部署",
      "items": [
        "本机 |vstolocal 部署：注册表 Manifest 直指 bin\\Release\\OutlookDateJump.vsto，不经 ClickOnce 缓存",
        "setup.exe 等发布产物在 bin\\Release\\app.publish\\，仅供其他机器安装",
        "VSTO 运行时负责信任校验、程序集加载与 Outlook Application 对象绑定",
        "ThisAddIn 经 CreateRibbonExtensibilityObject 提供 Ribbon1，并在启动后空闲时刻预热 WPF"
      ]
    },
    {
      "dot": "amber",
      "title": "兼容性边界",
      "items": [
        "仅支持经典版 Outlook（Windows 桌面 COM 加载项通道）",
        "「新的 Outlook」为网页内核，不支持 VSTO/COM 加载项",
        "运行依赖 .NET Framework 4.7.2 与 VSTO Runtime 4.0（安装包自带引导）"
      ]
    }
  ]
}
