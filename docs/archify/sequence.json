    { "id": "getexplorer", "from": "rb1", "to": "ol", "y": 230, "label": "ActiveExplorer()", "variant": "default" },
    { "id": "explorer-ref", "from": "ol", "to": "rb1", "y": 258, "label": "Explorer 引用", "variant": "return" },
